#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hrl: hrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <65 66 36 35 52 67 69 68 53 37 38 70 54 7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
        };

        hrr: hrr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRR";
            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <70 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64 70 35 36 52 66 67 65 68 53 37 38 69>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&tog 4     &kp N1             &kp N2        &kp N3           &kp N4           &kp N5     &tog 2                                                                              &mo 5    &kp N6  &kp N7            &kp N8            &kp N9        &kp N0              &kp LC(C)
&kp ESC    &kp Q              &kp Y         &kp O            &kp U            &kp EQUAL  &none                                                                               &none    &kp X   &kp L             &kp D             &kp P         &kp Z               &kp ENTER
&kp B      &hrl LEFT_SHIFT C  &hrl LCTRL I  &hrl LEFT_ALT A  &hrl LEFT_GUI E  &kp MINUS  &none      &sk LS(LA(LC(LEFT_GUI)))  &sk LEFT_GUI           &kp DELETE   &kp ENTER  &none    &kp K   &hrr RIGHT_GUI H  &hrr RIGHT_ALT T  &hrr RCTRL N  &hrr RIGHT_SHIFT S  &kp W
&sk LSHFT  &kp APOS           &kp COMMA     &kp DOT          &kp SEMI         &kp FSLH                                        &sk LS(LA(LCTRL))      &kp ESCAPE                       &kp J   &kp M             &kp G             &kp F         &kp V               &sk RSHFT
&mo 3      &kp AMPS           &kp GRAVE     &kp LEFT         &kp RIGHT                   &kp SPACE  &lt 2 TAB                 &lt 1 ENTER            &lt 1 ENTER  &kp BSPC   &lt 1 R          &kp UP            &kp DOWN          &kp AMPS      &kp BACKSLASH       &mo 3
            >;
        };

        nav {
            bindings = <
&trans           &kp GRAVE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON      &kp COMMA     &trans                                                    &trans  &trans    &trans             &trans                &trans                 &trans         &trans
&kp EXCLAMATION  &kp LEFT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RIGHT_BRACKET  &kp QUESTION  &trans                                                    &trans  &trans    &kp RIGHT          &trans                &trans                 &trans         &trans
&kp HASH         &kp CARET         &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR         &kp ASTERISK  &trans       &caps_word  &trans           &trans  &trans  &trans  &kp UP    &kp LEFT           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans         &trans
&kp TILDE        &kp LESS_THAN     &kp PIPE              &kp MINUS              &kp GREATER_THAN   &kp SLASH                              &kp PERIOD       &trans                  &kp DOWN  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE      &kp GRAVE              &kp BACKSLASH  &trans
&trans           &kp AMPERSAND     &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp PLUS                         &kp PERCENT  &kp COLON   &kp AT_SIGN      &trans  &trans  &trans            &trans             &trans                &trans                 &trans         &trans
            >;

            label = "Nav";
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans    &trans    &trans     &trans  &trans                                                   &trans     &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &none                                                    &none      &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &trans
&trans  &trans  &trans    &trans    &trans     &trans  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &trans
&trans  &trans  &trans    &trans    &trans     &trans                       &kp HOME      &kp PG_UP                        &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&trans  &trans  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &trans           &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                       &none   &kp F7             &kp F8           &kp F9             &kp F10   &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans             &kp C_NEXT       &trans             &kp C_PP  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp C_VOLUME_UP    &kp C_PREV       &trans             &trans    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &kp C_VOLUME_DOWN  &kp K_MUTE       &trans             &trans    &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                     &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans    &trans   &trans
            >;
        };

        print {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C   &kp I   &kp A   &kp E   &trans  &trans  &trans  &trans      &trans     &trans  &trans  &trans  &kp H   &kp T   &kp N   &kp S   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &kp ENTER  &trans  &kp R           &trans  &trans  &trans  &trans  &trans
            >;

            label = "Yellow";
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };
    };
};
